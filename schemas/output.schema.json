          "oneOf": [
            {
              "$ref": "#/$defs/primaryMetric"
            },
            {
              "type": "null"
            }
          ]
        },
        "guardrails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guardrail"
          }
        },
        "expected_effect": {
          "oneOf": [
            {
              "$ref": "#/$defs/expectedEffect"
            },
            {
              "type": "null"
            }
          ]
        },
        "test": {
          "oneOf": [
            {
              "$ref": "#/$defs/test"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/confidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "rejection_reason": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready_to_test"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "problem_ids": {
                "minItems": 1
              },
              "target_segment": {
                "type": "string",
                "minLength": 1
              },
              "if": {
                "type": "string",
                "minLength": 1
              },
              "then": {
                "type": "string",
                "minLength": 1
              },
              "because": {
                "type": "string",
                "minLength": 1
              },
              "evidence_links": {
                "minItems": 1
              },
              "assumptions": {
                "minItems": 1
              },
              "falsification_condition": {
                "type": "string",
                "minLength": 1
              },
              "primary_metric": {
                "$ref": "#/$defs/primaryMetric"
              },
              "guardrails": {
                "minItems": 1
              },
              "expected_effect": {
                "$ref": "#/$defs/expectedEffect"
              },
              "test": {
                "$ref": "#/$defs/test"
              },
              "confidence": {
                "$ref": "#/$defs/confidence"
              },
              "readiness": {
                "properties": {
                  "ready": {
                    "const": true
                  },
                  "checks": {
                    "$ref": "#/$defs/allChecksPass"
                  },
                  "blocking_reasons": {
                    "maxItems": 0
                  }
                }
              },
              "rejection_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "readiness": {
                "properties": {
                  "ready": {
                    "const": false
                  },
                  "blocking_reasons": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "readiness": {
                "properties": {
                  "ready": {
                    "const": false
                  }
                }
              },
              "rejection_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "candidate"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "readiness": {
                "properties": {
                  "ready": {
                    "const": false
                  }
                }
              },
              "rejection_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
