        "jtbd_ids",
        "target_segment",
        "if",
        "then",
        "because",
        "evidence_links",
        "alternative_explanations",
        "assumptions",
        "falsification_condition",
        "primary_metric",
        "guardrails",
        "expected_effect",
        "test",
        "confidence",
        "readiness",
        "rejection_reason"
      ],
      "properties": {
        "hypothesis_id": {
          "$ref": "#/$defs/id"
        },
        "previous_hypothesis_id": {
          "$ref": "#/$defs/nullableId"
